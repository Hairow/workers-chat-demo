{
  "name": "edge-chat-demo",
  "compatibility_date": "2024-01-01",
  "main": "src/index.mjs",
  // 静态资源目录（平台层优先匹配，无需 Worker 代码处理）
  "assets": {
    "directory": "public"
  },
  // For production, override this with: wrangler secret put JWT_SECRET
  "vars": {
    "JWT_SECRET": "dev-secret-change-in-production"
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_ROOMS",
      "id": "d0af9fee83df43d4a06ab52ed22d372f"
    }
  ],
  // D1 归档数据库：先在 Dashboard 创建或 wrangler d1 create，再把 database_id 填进来
  "d1_databases": [
    {
      "binding": "d1", // Worker 代码里的绑定名
      "database_name": "my-db-name", // 数据库名称
      "database_id": "8578136b-3a1d-4543-b12c-88136633fe53", // 创建后替换为实际 ID
      "migrations_dir": "migrations" // D1 迁移文件目录（区别于顶层的 DO migrations）
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "rooms",
        "class_name": "ChatRoom"
      },
      {
        "name": "limiters",
        "class_name": "RateLimiter"
      }
    ]
  },
  // Indicate that you want the ChatRoom and RateLimiter classes to be callable as Durable Objects.
  "migrations": [
    {
      "tag": "v1", // Should be unique for each entry
      "new_sqlite_classes": [
        "ChatRoom",
        "RateLimiter"
      ]
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  }
}